parameters:
    level: 5
    paths:
        - src
    excludePaths:
        - src/Http/Request/Accounting/GetAccountingRequest.php
    ignoreErrors:
        -
            identifier: nullCoalesce.expr
            path: src/Http/HubConnector.php
        -
            identifier: function.alreadyNarrowedType
        -
            identifier: trait.unused
            path: src/Webhooks/SerializesHubWebhookByIds.php
    reportUnmatchedIgnoredErrors: false
