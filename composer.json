{
  "name": "emeq/hub-sdk",
  "description": "Laravel 13 consumer SDK for the emeq Hub /v1 API — provider-agnostic (new Hub partners appear without SDK changes).",
    "keywords": [
        "emeq",
        "laravel",
        "hub",
        "saloon",
        "api-client",
        "accounting"
    ],
    "homepage": "https://github.com/yusufkaracaburun/emeq-hub-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Yusuf Karacaburun",
            "email": "info@emeq.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "saloonphp/saloon": "^4.0",
        "spatie/laravel-package-tools": "^1.16",
        "spatie/laravel-webhook-client": "^3.4"
    },
    "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/boost": "^2.5",
    "laravel/pint": "^1.14",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^3.0|^4.0",
    "pestphp/pest-plugin-laravel": "^3.0|^4.0",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan-deprecation-rules": "^2.0"
  },
    "autoload": {
        "psr-4": {
            "Emeq\\HubSdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Emeq\\HubSdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Emeq\\HubSdk\\HubServiceProvider"
            ],
            "aliases": {
                "Hub": "Emeq\\HubSdk\\Facades\\Hub"
            }
        },
        "branch-alias": {
            "dev-master": "0.7.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
